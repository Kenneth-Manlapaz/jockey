# Mock-only auth bypass. Real API mode always requires account sign-in.
# Restart Expo with cache cleared after changing: npx expo start -c
EXPO_PUBLIC_BYPASS_AUTH=true

# The API currently returns simulated demo racing data, not official live data.
# Set EXPO_PUBLIC_USE_MOCK_API=true to use in-repo fixture data instead.
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
