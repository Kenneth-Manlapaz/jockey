# Copy to .env (never commit it) and edit.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain
# DJANGO_SSL_REDIRECT=True

# Next.js origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# mysql (MariaDB) or sqlite (quick start, no database server)
DB_ENGINE=mysql
DB_NAME=philippine_jockey
DB_USER=racing_app
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# 1 = you ran sql/02_philippine_jockey_logic.sql (its triggers log bet status changes)
# 0 = Django does that itself. Default: 1 for mysql, 0 for sqlite.
# USE_DB_TRIGGERS=1

# Phase 1 is information-only: set to 0 to hide /games, /bets and /races/{id}/settle
ENABLE_BETTING_API=True

# Showcase checkout: every completed preview payment is approved without charging money.
# Set ENABLE_PREVIEW_SUBSCRIPTIONS=False before connecting real payments.
RACING_SUBSCRIPTION_REQUIRED=True
ENABLE_PREVIEW_SUBSCRIPTIONS=True
